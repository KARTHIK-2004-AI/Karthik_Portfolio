# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (for production - PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/portfolio_db

# CORS Settings (add your frontend URL)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email / SMTP Settings (Production)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=noreply@karthikaarupalli.com
NOTIFY_EMAIL=aaarupallikarthik@gmail.com

# PythonAnywhere Settings (uncomment for production)
# PYTHONANYWHERE_USERNAME=your_username
# PYTHONANYWHERE_DOMAIN=your_username.pythonanywhere.com

